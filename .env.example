# ==========================================================
#  DESIGN COPYCAT AI - CẤU HÌNH MÔI TRƯỜNG
#  Copy file này thành `.env` rồi điền thông tin thật.
# ==========================================================

# ---------- 1. SERVER ----------
PORT=4000
# Địa chỉ lắng nghe. Chạy sau nginx trên VPS thì đặt 127.0.0.1 để không lộ cổng Node ra Internet.
HOST=0.0.0.0
# URL public của web. Khi chạy thật đổi thành https://tenmien-cua-ban.com
# Stripe dựng link quay-về từ giá trị này, nên để sai là khách thanh toán xong
# bị ném về localhost.
APP_URL=http://localhost:3000
# Đặt production khi chạy thật (bắt buộc có HTTPS, xem mục Deploy trong README)
NODE_ENV=development

# ---------- 2. DATABASE (MySQL / MariaDB) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=copycat_ai
# Server sẽ tự tạo database + bảng nếu chưa có (đặt false nếu bạn tự quản lý schema)
DB_AUTO_MIGRATE=true

# ---------- 3. BẢO MẬT ----------
# BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài khi chạy thật.
# Gợi ý sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_chuoi_nay_thanh_mot_chuoi_ngau_nhien_that_dai
JWT_EXPIRES_IN=7d

# ---------- 4. TÀI KHOẢN ADMIN ----------
# Danh sách email có quyền admin, phân tách bằng dấu phẩy.
# Ai đăng ký bằng email nằm trong danh sách này sẽ tự động là admin.
# Thêm email vào đây rồi restart server là tài khoản đó lên admin ngay (không cần sửa DB).
ADMIN_EMAILS=admin@nextgenholdings.nl

# (Tuỳ chọn) Tự tạo sẵn 1 tài khoản admin khi khởi động lần đầu.
# Để trống nếu bạn muốn tự đăng ký qua giao diện.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- 5. NHÀ CUNG CẤP AI (bên thứ 3) ----------
# API key Kie.ai - dùng chung cho toàn hệ thống, KHÔNG lộ ra client nữa.
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
# ĐỪNG đổi sang api.kie.ai: endpoint upload nằm ở host riêng này. Địa chỉ ghi
# trong tài liệu (api.kie.ai/api/file-base64-upload) trả về 404, đã kiểm chứng.
KIE_UPLOAD_URL=https://kieai.redpandaai.co/api/file-base64-upload

# QUY ƯỚC ĐƠN VỊ ĐIỂM: bao nhiêu điểm ứng với $1 giá vốn nhà cung cấp.
# 10.000 điểm = $1 nghĩa là 1 điểm = $0,0001. Mọi con số trong bảng giá suy ra
# từ hằng số này (token_cost = api_cost_usd x CREDITS_PER_USD).
#
# ĐỪNG đổi trên hệ thống đang chạy: nó định giá lại toàn bộ số dư điểm của khách
# và làm lệch mọi báo cáo lợi nhuận cũ. Muốn đổi biên lợi nhuận thì sửa giá gói
# trong Quản trị -> Bảng giá.
CREDITS_PER_USD=10000

# ---------- 5a. GỬI MAIL (SMTP) ----------
# Dùng cho chức năng quên mật khẩu. Chưa điền thì nút "Quên mật khẩu" vẫn bấm
# được nhưng không mail nào được gửi (server sẽ ghi cảnh báo ra log).
SMTP_HOST=
# 587 = STARTTLS (phổ biến nhất) | 465 = TLS thẳng
SMTP_PORT=587
# Bỏ trống thì tự suy ra: true nếu cổng là 465, còn lại false.
SMTP_SECURE=
SMTP_USER=
# LƯU Ý với Gmail: KHÔNG dùng mật khẩu đăng nhập thường. Vào
# https://myaccount.google.com/apppasswords để tạo "mật khẩu ứng dụng" 16 ký tự
# (cần bật xác minh 2 bước trước), rồi dán vào đây.
SMTP_PASSWORD=
# Địa chỉ hiện ở ô "Từ" trong mail. Bỏ trống thì dùng luôn SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=Design Copycat AI

# Link đặt lại mật khẩu sống được bao nhiêu phút.
PASSWORD_RESET_MINUTES=15

# ---------- 5b. THÔNG TIN PHÁP LÝ & LIÊN HỆ ----------
# Hiển thị ở cuối trang Chính sách (/policies). Để trống thì trang vẫn chạy
# nhưng sẽ hiện cảnh báo nhắc bổ sung — nên điền trước khi bán hàng thật.
# LƯU Ý: trang này hiển thị cho KHÁCH nên nội dung phải bằng tiếng Anh.
COMPANY_NAME=
COMPANY_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Ngày cập nhật chính sách gần nhất, dạng dd/mm/yyyy
POLICY_UPDATED_AT=

# ---------- 6. THANH TOÁN (STRIPE) ----------
# Khoá bí mật Stripe. sk_test_... khi thử, sk_live_... khi bán thật.
# Lấy ở https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Signing secret của endpoint webhook (whsec_...).
# BẮT BUỘC khi bán thật: thiếu nó server TỪ CHỐI mọi webhook, vì không xác minh
# được chữ ký nghĩa là ai cũng bắn được request giả để tự cộng điểm.
#
#   Chạy thật : Dashboard -> Developers -> Webhooks -> Add endpoint
#               URL: https://tenmien-cua-ban.com/api/webhooks/stripe
#               Sự kiện: checkout.session.completed
#                        checkout.session.async_payment_succeeded
#   Chạy thử  : stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Mã tiền tệ ISO gửi lên Stripe. Đổi thì phải đổi cả bảng giá cho khớp.
STRIPE_CURRENCY=usd

# Tiền tố mã đơn (chỉ để tra soát và hỗ trợ khách, không phải gõ vào đâu cả)
ORDER_PREFIX=ORD
# Số phút đơn còn hiệu lực trước khi bị đánh dấu hết hạn
ORDER_EXPIRE_MINUTES=60

# Chu kỳ quét đơn được hệ thống ngoài đánh dấu đã thanh toán (giây, tối thiểu 5).
# Nếu bạn dùng workflow riêng ghi thẳng `UPDATE orders SET status='paid'` vào DB,
# server sẽ tự phát hiện trong khoảng thời gian này rồi cộng điểm.
ORDER_SYNC_INTERVAL_SECONDS=20

# ---------- 7. LƯU TRỮ ẢNH ----------
# Thư mục lưu ảnh trên server (tương đối so với thư mục gốc dự án)
STORAGE_DIR=server/storage
# Tự tải ảnh kết quả từ nhà cung cấp về server (khuyến nghị true để link không hết hạn)
DOWNLOAD_RESULTS=true

# ---------- 8. GIỚI HẠN ----------
# Số job tạo ảnh chạy song song tối đa trên toàn hệ thống
MAX_CONCURRENT_JOBS=24
# Số ảnh của MỘT user được gọi lên Kie.ai cùng lúc.
# 8 = 2 ảnh mẫu x 4 bản. Nâng lên thì lô lớn xong nhanh hơn nhưng dễ bị Kie.ai
# chặn rate-limit; hạ xuống thì ảnh ra nhỏ giọt theo từng đợt.
MAX_CONCURRENT_JOBS_PER_USER=8
# Số ảnh tối đa 1 user được xếp hàng cùng lúc.
# Phải >= 32 (8 ảnh mẫu x 4 bản) để không chặn nhầm lô lớn nhất mà giao diện cho chọn.
MAX_QUEUE_PER_USER=32
